{
  "manifest_version": 3,
  "name": "JSRecon — JavaScript Reconnaissance Tool",
  "version": "1.0.0",
  "description": "Passive JavaScript asset reconnaissance and sensitive information detection for ethical security research.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JSRecon Scanner"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
